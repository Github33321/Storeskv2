# Адрес сервера
APP_ADDR=:8082

# Подключение к локальному Postgres в docker-compose (сервис "db")
DB_DSN=host=db user=shop password=shop dbname=shop port=5432 sslmode=disable TimeZone=UTC

# Куда складывать картинки/файлы (в контейнере /app/uploads)
UPLOAD_DIR=./uploads

# Бутстрап админа (локальные тестовые)
ADMIN_BOOTSTRAP_EMAIL=dev@example.com
ADMIN_BOOTSTRAP_PASSWORD=devpass123

# JWT (локальный)
JWT_SECRET=devsecret-change-me

# Телеграм можно выключить в локалке
TELEGRAM_POLLING=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_BOT_USERNAME=

# Базы URL для генерации ссылок/схем
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
